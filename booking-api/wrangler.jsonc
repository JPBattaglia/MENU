// Deploy config for the live `menu-checkout` worker (NOT the static site — that is ../wrangler.jsonc).
// Deploy: cd booking-api && npx wrangler deploy
// Since Nov 9, 2026 every push to master is tested and deployed by Cloudflare Workers Builds (root /booking-api,
// build "npm install && npm test", deploy "npx wrangler deploy"), so deploys don't depend on GitHub Actions minutes
// (the free allowance ran out that day). .github/workflows/menu-checkout.yml still runs when Actions has minutes.
// Secrets (Stripe, Resend, Anthropic, runner secret) live in Cloudflare only and are never written here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menu-checkout",
  "main": "src/main.js",
  // 2026-03-24 is the earliest date with BROWSER.quickAction (Browser Run, below). Before Nov 12, 2026 this was
  // 2026-03-05, the version live before the split (b4e65b8b); the only default that changed in between and could
  // matter is WebSocket binary frames arriving as Blob (2026-03-17), and this worker opens no WebSockets.
  "compatibility_date": "2026-03-24",
  // Keep any plain-text variables already set in the dashboard (OWNER_EMAIL, PUBLIC_BASE_URL, BOOKING_*, ...).
  "keep_vars": true,
  // Customer sites are served at <slug>.menu-made.com (wildcard DNS + route verified live Oct 27, 2026), so emails
  // and pages show that address instead of menu-made.com/api/site/<slug>/.
  // SELFTEST_SCHEDULE: the daily self-tests schedule themselves only where this is "on" (src/selftest/daily-clock.js).
  // CF_ACCOUNT_ID: Menu-made's Cloudflare account, for the Registrar API (src/producers/website/registrar.js).
  "vars": { "SITE_WILDCARD": "1", "SELFTEST_SCHEDULE": "on", "CF_ACCOUNT_ID": "62531e43b35eeda3680b53b0c654177d", "OWNER_SANDBOX_LOCK": "on" },
  "d1_databases": [
    { "binding": "DB", "database_name": "menu-made-db", "database_id": "1387bcdc-e462-41ce-bc6b-5cc1b0a47ad0" },
    // Marketing plan v4: the Nino shop's database, read only by the Friday numbers email (src/marketing/weekly-numbers.js).
    { "binding": "NINO_DB", "database_name": "nino-printful-commerce", "database_id": "3b48a25e-1854-48ca-b821-ef1552d385cc" }
  ],
  // Not read by the current code; kept so the binding set matches the pre-split worker.
  "kv_namespaces": [
    { "binding": "STRIPE_EVENTS", "id": "28987675a91d4778b39f1c25e81851b3" }
  ],
  // Stage 10 staff merch: the Nino shop's private entrypoint, which holds the Printful token (deploy the Nino worker first).
  "services": [
    { "binding": "MERCH", "service": "nino-printful-commerce-api", "entrypoint": "NinoMerch" }
  ],
  // Cloudflare Browser Run: prints the menu page to PDF so print PDF, tri-fold and table tent match the chosen design
  // (src/producers/menu-qr/browser-pdf.js). Included with Workers Paid: 10 browser hours a month, then $0.09 an hour.
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "menu-made-assets" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "menu-made.com/api/*", "zone_name": "menu-made.com" },
    { "pattern": "www.menu-made.com/api/*", "zone_name": "menu-made.com" },
    // Generated customer sites live at <slug>.menu-made.com. www is redirected
    // to the apex by a Cloudflare redirect rule before it reaches the Worker.
    { "pattern": "*.menu-made.com/*", "zone_name": "menu-made.com" },
    // Customers' own domains (Cloudflare for SaaS custom hostnames) enter the zone under their own names, so only a
    // catch-all route reaches them. More specific routes above still win; menu-made.com's own pages pass through
    // (website/hosts.js). Inert until a custom hostname exists.
    { "pattern": "*/*", "zone_name": "menu-made.com" }
  ],
  // Fonts for Social Posts graphics are read as raw bytes.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
